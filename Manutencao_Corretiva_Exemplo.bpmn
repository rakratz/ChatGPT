<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_ManutencaoCorretiva"
                  targetNamespace="http://example.com/process">
  <bpmn:process id="Proc_ManutencaoCorretiva" name="Solicitação de Manutenção Corretiva" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MC">
      <bpmn:lane id="Lane_Solic" name="Solicitante"/>
      <bpmn:lane id="Lane_Prod" name="Produção"/>
      <bpmn:lane id="Lane_Manu" name="Manutenção"/>
      <bpmn:lane id="Lane_Qual" name="Qualidade"/>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_MC" name="Falha detectada"/>
    <bpmn:userTask id="Task_AbrirChamado" name="Abrir chamado no CMMS"/>
    <bpmn:exclusiveGateway id="Gw_ParadaSegura" name="Parada segura?"/>
    <bpmn:userTask id="Task_ParadaEmerg" name="Executar parada de emergência"/>
    <bpmn:userTask id="Task_Isolamento" name="Isolar energia e travar bloqueios (LOTO)"/>
    <bpmn:exclusiveGateway id="Gw_Peca" name="Peça disponível?"/>
    <bpmn:userTask id="Task_BuscarPeca" name="Buscar peça no almoxarifado"/>
    <bpmn:userTask id="Task_Reparo" name="Executar reparo"/>
    <bpmn:userTask id="Task_Teste" name="Teste funcional"/>
    <bpmn:exclusiveGateway id="Gw_Aprov" name="Aprovado na Qualidade?"/>
    <bpmn:endEvent id="End_MC" name="Linha liberada"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_MC" targetRef="Task_AbrirChamado"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_AbrirChamado" targetRef="Gw_ParadaSegura"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_ParadaSegura" targetRef="Task_ParadaEmerg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[no]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_ParadaEmerg" targetRef="Task_Isolamento"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_ParadaSegura" targetRef="Task_Isolamento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Isolamento" targetRef="Gw_Peca"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Peca" targetRef="Task_BuscarPeca">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[no]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_BuscarPeca" targetRef="Task_Reparo"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Peca" targetRef="Task_Reparo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Reparo" targetRef="Task_Teste"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Teste" targetRef="Gw_Aprov"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Aprov" targetRef="End_MC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_Aprov" targetRef="Task_Reparo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[no]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diag_ManutencaoCorretiva">
    <bpmndi:BPMNPlane id="Plane_MC" bpmnElement="Proc_ManutencaoCorretiva">
      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Solic_di" bpmnElement="Lane_Solic" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Prod_di" bpmnElement="Lane_Prod" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manu_di" bpmnElement="Lane_Manu" isHorizontal="true">
        <dc:Bounds x="160" y="320" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Qual_di" bpmnElement="Lane_Qual" isHorizontal="true">
        <dc:Bounds x="160" y="440" width="1000" height="120"/>
      </bpmndi:BPMNShape>

      <!-- Shapes -->
      <bpmndi:BPMNShape id="Start_MC_di" bpmnElement="Start_MC">
        <dc:Bounds x="190" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AbrirChamado_di" bpmnElement="Task_AbrirChamado">
        <dc:Bounds x="250" y="110" width="160" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ParadaSegura_di" bpmnElement="Gw_ParadaSegura" isMarkerVisible="true">
        <dc:Bounds x="440" y="118" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ParadaEmerg_di" bpmnElement="Task_ParadaEmerg">
        <dc:Bounds x="520" y="110" width="210" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Isolamento_di" bpmnElement="Task_Isolamento">
        <dc:Bounds x="530" y="230" width="210" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Peca_di" bpmnElement="Gw_Peca" isMarkerVisible="true">
        <dc:Bounds x="770" y="238" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuscarPeca_di" bpmnElement="Task_BuscarPeca">
        <dc:Bounds x="840" y="110" width="170" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reparo_di" bpmnElement="Task_Reparo">
        <dc:Bounds x="840" y="230" width="170" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Teste_di" bpmnElement="Task_Teste">
        <dc:Bounds x="1030" y="230" width="160" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Aprov_di" bpmnElement="Gw_Aprov" isMarkerVisible="true">
        <dc:Bounds x="1210" y="238" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_MC_di" bpmnElement="End_MC">
        <dc:Bounds x="1300" y="246" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="226" y="138"/>
        <di:waypoint x="250" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="410" y="140"/>
        <di:waypoint x="440" y="143"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="465" y="143"/>
        <di:waypoint x="520" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="730" y="140"/>
        <di:waypoint x="530" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="465" y="168"/>
        <di:waypoint x="565" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="740" y="260"/>
        <di:waypoint x="770" y="263"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="795" y="263"/>
        <di:waypoint x="860" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1010" y="140"/>
        <di:waypoint x="925" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="795" y="263"/>
        <di:waypoint x="840" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1010" y="260"/>
        <di:waypoint x="1030" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1190" y="260"/>
        <di:waypoint x="1210" y="263"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="1260" y="263"/>
        <di:waypoint x="1300" y="264"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13">
        <di:waypoint x="1210" y="263"/>
        <di:waypoint x="1030" y="260"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
